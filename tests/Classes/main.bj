//Classes >O<

struct Vector2D //all struct variables are public within its scope
{
    var x->int = 0;
    var y->int = 0;
}

class Character
{
public:
    var Name->text;
    
private:
    var Position->Vector2D = {1, 3}; //default value initialization, assumed constructor
    
public:
    func Character(fp_Position->Vector2D) -> void
    {
        Position = fp_Position;
    }

    func CurrentPosition() -> void
    {
        print(f"My character is at x : {Position.x}, y : {Position.y}!", "bright blue"); //formatted string output with class member
    }
}

func main() -----------> int
{
    var Ryan->Character = Character({6, 9}); //typical class creation, typical heap value

    Ryan.CurrentPosition();

    var Gaurav->Character = Ryan; //reference to Ryan class

    Gaurav.Position = {0, 1}; //change current position

    Ryan.CurrentPosition(); //will print with {0, 1} instead since Gaurav is a ptr ref to the original character creation
    Gaurav.CurrentPosition(); //will print name as Ryan since Gaurav only got a reference to Ryan

    Gaurav = Character({0, 0}); //Gaurav gets a brand new unique Character reference

    Ryan.CurrentPosition(); //will print with {0, 1} instead since Gaurav is a ptr ref to the original character creation
    Gaurav.CurrentPosition(); //will print name as Ryan since Gaurav only got a reference to Ryan

    return 0;
}